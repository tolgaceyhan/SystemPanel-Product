<?xml version="1.0" encoding="utf-8"?>
<!--
  Varsayılan paket kaynağı: nuget.org (CI ve internete erişimi olan geliştirici makineleri).
  Kapalı ağ (offline) derleme için nuget.offline.example.config dosyasını kullanın:
    dotnet restore SystemPanel.sln -configfile nuget.offline.config
  Bkz. docs/DEPLOYMENT.md "Kapalı ağda derleme".
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
