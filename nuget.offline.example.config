<?xml version="1.0" encoding="utf-8"?>
<!--
  ÖRNEK: kapalı ağdaki derleme makinesinde nuget.offline.config olarak kopyalayın ve
  value değerini yerel paket klasörünüzle değiştirin (önceki sabit yol bir sürücü harfine bağlıydı).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="Offline" value="<yerel-nuget-paket-klasoru>" />
  </packageSources>
</configuration>
