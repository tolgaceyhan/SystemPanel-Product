  "supportsDryRun": false,
  "idempotent": true,
  "timeoutSeconds": 300,
  "parameters": [
    { "name": "SearchBase", "type": "ad-dn", "label": "Arama kökü (OU DN)", "required": true, "inScope": true },
    { "name": "Days", "type": "int", "label": "Pasif gün sayısı", "required": true, "min": 30, "max": 730, "default": "90" }
  ]
}
