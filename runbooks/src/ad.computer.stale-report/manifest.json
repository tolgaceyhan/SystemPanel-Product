{
  "id": "ad.computer.stale-report",
  "version": "1.0.0",
  "title": "Pasif bilgisayar raporu",
  "description": "Belirtilen OU altında, verilen gün sayısından uzun süredir oturum açmamış bilgisayar hesaplarını listeler. Değişiklik yapmaz.",
  "executor": "server",
