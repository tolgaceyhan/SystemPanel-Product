<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-AgentSystemPanel-f1b8862a-b20c-4fdb-ab3e-1f1e2e18ed3c</UserSecretsId>
    <AssemblyName>SystemPanel.Agent</AssemblyName>
    <RootNamespace>AgentSystemPanel</RootNamespace>
    <Version>2.0.0</Version>
    <!-- Yayın: "dotnet publish -c Release -r win-x64 /p:SelfContained=true" (bkz. docs/AGENT.md) -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.10" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SystemPanel.Contracts\SystemPanel.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentSystemPanel.Tests" />
  </ItemGroup>

  <!-- Üretici runbook imzalama açık anahtarı (sunucuyla aynı dosya). Yoksa yalnızca Agent:Automation:TrustedKeyFiles geçerlidir. -->
  <ItemGroup>
    <EmbeddedResource Include="..\SystemPanel\Automation\runbook-vendor-public.pem" Condition="Exists('..\SystemPanel\Automation\runbook-vendor-public.pem')" LogicalName="SystemPanel.Agent.runbook-vendor-public.pem" />
  </ItemGroup>
</Project>
