{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "LogLevel": { "Default": "Warning" }
    }
  },
  "Agent": {
    "_comment": "Sunucuya özel değerler (ServerUrl, AgentId, AgentKey) %ProgramData%\\SystemPanel\\Agent\\agentsettings.json dosyasına Install-SystemPanelAgent.ps1 ile yazılır. Bu dosyaya sır yazmayın.",
    "ServerUrl": "",
    "AgentId": "",
    "AgentKey": "",
    "IntervalSeconds": 30,
    "HeartbeatIntervalSeconds": 60,
    "TimeoutSeconds": 15,
    "EnabledCollectors": [ "cpu", "memory", "disk" ],
    "BufferMaxItems": 1000,
    "MaxBackoffSeconds": 300,
    "AllowInsecureHttp": false
  }
}
