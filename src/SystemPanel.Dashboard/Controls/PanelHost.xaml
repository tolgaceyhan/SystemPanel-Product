<UserControl x:Class="SystemPanel.Dashboard.Controls.PanelHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             AllowDrop="False"
             MouseLeftButtonDown="Panel_MouseDown"
             MouseMove="Panel_MouseMove">

    <Grid Background="Black">

        <!-- WEB (arka plan) -->
        <wv2:WebView2 x:Name="Web"
                      Panel.ZIndex="0"/>

        <!-- TOP BAR -->
        <Border Background="#CC1E1E1E"
                Height="32"
                VerticalAlignment="Top"
                Panel.ZIndex="2">
            <DockPanel Margin="8,0">

                <TextBlock x:Name="TitleText"
                           Foreground="White"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <TextBlock x:Name="StatusText"
                           Foreground="LightGreen"
                           FontSize="11"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">

                    <Button Content="⟳"
                            Width="26"
                            Height="22"
                            Margin="0,0,6,0"
                            ToolTip="Yenile"
                            Click="Refresh_Click"/>

                    <Button x:Name="MaximizeButton"
                            Content="⛶"
                            Width="26"
                            Height="22"
                            ToolTip="Tam ekran"
                            Click="Maximize_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ERROR OVERLAY -->
        <Border x:Name="ErrorOverlay"
                Background="#AA000000"
                Visibility="Collapsed"
                Panel.ZIndex="3">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="360">

                <TextBlock Text="Panel yüklenemedi"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock x:Name="ErrorText"
                           Foreground="LightGray"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,12"/>

                <Button Content="Tekrar Dene"
                        Width="120"
                        Click="Retry_Click"/>
            </StackPanel>
        </Border>

        <!-- EDIT MODE VISUAL (ince çerçeve) -->
        <Border x:Name="EditModeBorder"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                Panel.ZIndex="4"/>
    </Grid>
</UserControl>
