<Window x:Class="SystemPanel.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SystemPanel Dashboard"

        Width="1400"
        Height="900"
        MinWidth="1200"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"

        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <DockPanel>

        <!-- MENU -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="Dosya">
                <MenuItem Header="Çıkış" Click="MenuExit_Click"/>
            </MenuItem>
        </Menu>

        <!-- TOP BAR (DRAG AREA) -->
        <Border DockPanel.Dock="Top"
                Background="#FF1E1E1E"
                Height="36"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <DockPanel Margin="10,0">
                <TextBlock Text="System Dashboard"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="TopStatus"
                           Foreground="LightGray"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- PANELS -->
        <Grid x:Name="RootGrid" Background="Black"/>

    </DockPanel>
</Window>
