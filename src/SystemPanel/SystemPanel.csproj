<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Framework -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- SELF-CONTAINED: yalnızca Release (IIS yayını) için. Debug/test derlemeleri
         framework-dependent kalır; aksi halde test projeleri bu projeye referans veremez
         (NETSDK1151) ve CI Linux üzerinde derleyemez. -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>

    <!-- IIS -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>

    <!-- Publish stabilitesi -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Diğer -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- GenerateAssemblyInfo=false olduğu için InternalsVisibleTo öğesi yerine özniteliği kullanırız: Properties/AssemblyAttributes.cs -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <MvcRazorCompileOnPublish>false</MvcRazorCompileOnPublish>
    <UserSecretsId>39376427-6651-4211-ada6-088084b5881c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- UTILITIES -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />

    <!-- PDF (MIT lisanslı; itext7 AGPL olduğu için ticari dağıtımda kullanılamaz) -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />

    <!-- PowerShell -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.4" />

    <!-- IDENTITY -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.10" />

    <!-- ROSLYN (SABİT): EF Core Design araçlarının sürüm çakışmasını (NU1107) önler -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />

    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- EF / SQL -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.10" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- SERVICES -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.10" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
	
	  <!-- WMI / CIM (Windows Only) -->
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <PackageReference Include="Microsoft.Management.Infrastructure.Runtime.Win" Version="3.0.0" />

    <!-- LOGGING -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- API DOC -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />

    <!-- SYSTEM -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.10" />
    <PackageReference Include="System.DirectoryServices" Version="9.0.10" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="9.0.10" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="9.0.10" />
    <PackageReference Include="System.Management" Version="9.0.10" />
    <!-- 9.0.10: NU1903 (bilinen yüksek önemli açıklar). Doğrudan kullanılmıyor; geçişli sürümü yamalı sürüme sabitler. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.10" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.22" />
    <PackageReference Include="System.Text.Json" Version="9.0.10" />
    <PackageReference Include="System.Web.Services.Description" Version="8.1.2" />

    <!-- UI -->
    <PackageReference Include="X.PagedList" Version="10.5.9" />
    <PackageReference Include="X.PagedList.Mvc.Core" Version="10.5.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SystemPanel.Contracts\SystemPanel.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Views\Announcements\Details.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Update="wwwroot\js\map-units.js">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="logs\" />
    <Folder Include="Migrations\" />
    <Folder Include="Properties\" />
  </ItemGroup>

  <!--
    Lisans doğrulama açık anahtarı. Dosya yoksa (geliştirme yapısı) lisans kontrolü devre dışıdır.
    Anahtar çifti tools/SystemPanel.LicenseTool ile üretilir; ÖZEL anahtar repoya asla eklenmez.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Licensing\license-public.pem" Condition="Exists('Licensing\license-public.pem')" LogicalName="SystemPanel.Licensing.license-public.pem" />
  </ItemGroup>

</Project>
