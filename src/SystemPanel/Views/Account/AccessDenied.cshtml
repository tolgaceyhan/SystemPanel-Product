@{
    ViewData["Title"] = "Yetkiniz Yok";
}

<div class="container text-center mt-5">
    <h1 class="text-danger">
        <i class="fas fa-user-lock"></i> Erişim Engellendi
    </h1>
    <p class="lead mt-3">
        Bu sayfaya erişim için gerekli yetkiniz bulunmamaktadır.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning mt-3">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="mt-4">
        <a href="/" class="btn btn-primary">
            Ana Sayfaya Dön
        </a>
        <form asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger ms-2">
                <i class="fas fa-right-from-bracket"></i> Çıkış Yap
            </button>
        </form>
    </div>
</div>
