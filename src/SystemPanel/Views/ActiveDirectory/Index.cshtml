@{
    ViewData["Title"] = "Active Directory | OU Tarayıcı";
}

<style>
    /* OU ağacı: satırlar kompakt, metin taşarsa ellipsis */
    #ouTree .list-group-item {
        padding: .15rem .25rem;
        border-radius: 0;
        border-left: 0;
        border-right: 0;
    }

    #ouTree .ou-node {
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: .25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #ouTree .ou-label {
        display: inline-block;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #ouTree .toggle-icon {
        width: 1rem;
        text-align: center;
        font-weight: bold;
        font-size: .8rem;
        color: #ccc;
    }

    #ouTree .has-children .toggle-icon {
        color: #0d6efd;
    }

    /* Seçili OU rozeti */
    #selectedOuBadge.badge-ou {
        max-width: 65%;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Sonuç tablolarında uzun alanlar ellipsis */
    .truncate {
        max-width: 260px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .w-email {
        max-width: 320px;
    }
</style>

<div class="row mt-3">
    <!-- OU Ağacı -->
    <div class="col-md-3 border-end">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="m-0">OU Yapısı</h5>
            <button id="btnRefreshTree" class="btn btn-sm btn-outline-secondary">↻</button>
        </div>
        <ul id="ouTree" class="list-group small"></ul>
        <div class="text-muted small mt-2">Bir OU’ya tıklayın.</div>
    </div>

    <!-- İçerik -->
    <div class="col-md-9">
        <!-- Arama -->
        <div class="mb-3">
            <div class="input-group">
                <input id="searchBox" class="form-control" placeholder="Kullanıcı ara (kullanıcı adı, ad, soyad, mail)..." />
                <button id="btnClearSearch" class="btn btn-outline-secondary">Temizle</button>
            </div>
            <div class="form-text">
                Arama sonuçları yetkili olduğunuz OU kapsamlarında listelenir. OU seçiliyse sağdaki butonlardan ilgili OU’nun kullanıcı/bilgisayarlarını görebilirsiniz.
            </div>
        </div>

        <!-- OU İşlemleri -->
        <div id="ouActions" class="mb-3" style="display:none;">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-info text-dark badge-ou" id="selectedOuBadge"></span>
                <button id="btnUsers" class="btn btn-primary btn-sm">
                    <i class="fas fa-user me-1"></i> Kullanıcılar
                </button>
                <button id="btnComputers" class="btn btn-secondary btn-sm">
                    <i class="fas fa-desktop me-1"></i> Bilgisayarlar
                </button>
            </div>
        </div>

        <!-- Sonuç Alanı -->
        <div id="resultArea" class="mt-2">
            <p class="text-muted">Soldan bir OU seçin ya da arama yapın.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                // ========================
                // Global durum & yardımcılar
                // ========================

                let currentOuDn = null;
                let ouTreeData = null;

                const qs = (sel, root = document) => root.querySelector(sel);

                function formatOuPath(dn) {
                    if (!dn) return '';
                    return dn
                        .split(',')
                        .map(p => p.trim())
                        .filter(p => p.toUpperCase().startsWith('OU='))
                        .map(p => p.substring(3))
                        .join(' / ');
                }

                function setSelectedOu(dn, name) {
                    currentOuDn = dn;
                    const badge = qs('#selectedOuBadge');
                    const pretty = formatOuPath(dn) || name || dn;
                    badge.textContent = pretty;
                    qs('#ouActions').style.display = 'block';
                }

                async function fetchJson(url) {
                    const r = await fetch(url, { credentials: 'same-origin' });
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return await r.json();
                }

                // ========================
                // OU AĞACI
                // ========================

                function buildOuNode(node) {
                    const li = document.createElement('li');
                    li.className = 'list-group-item';

                    const hasChildren = node.childOus && node.childOus.length > 0;

                    const header = document.createElement('div');
                    header.className = 'ou-node d-flex align-items-center';
                    header.setAttribute('data-dn', node.distinguishedName || '');
                    header.setAttribute('data-name', node.ouName || node.distinguishedName || '');

                    const toggleIcon = document.createElement('span');
                    toggleIcon.className = 'toggle-icon' + (hasChildren ? ' has-children' : '');
                    toggleIcon.textContent = hasChildren ? '▸' : '';

                    const label = document.createElement('span');
                    label.className = 'ou-label';
                    label.textContent = node.ouName || node.distinguishedName || '(OU)';

                    header.appendChild(toggleIcon);
                    header.appendChild(label);
                    li.appendChild(header);

                    let childrenUl = null;
                    if (hasChildren) {
                        childrenUl = document.createElement('ul');
                        childrenUl.className = 'list-group ms-3 my-1';
                        childrenUl.style.display = 'none';

                        node.childOus.forEach(ch => {
                            childrenUl.appendChild(buildOuNode(ch));
                        });

                        li.appendChild(childrenUl);
                    }

                    header.addEventListener('click', () => {
                        const dn = header.getAttribute('data-dn');
                        const name = header.getAttribute('data-name');
                        setSelectedOu(dn, name);

                        if (childrenUl) {
                            const visible = childrenUl.style.display !== 'none';
                            childrenUl.style.display = visible ? 'none' : '';
                            toggleIcon.textContent = visible ? '▸' : '▾';
                        }
                    });

                    return li;
                }

                function renderOuTree(root) {
                    const treeEl = qs('#ouTree');
                    treeEl.innerHTML = '';
                    if (!root) {
                        treeEl.innerHTML = '<li class="list-group-item text-danger">OU verisi alınamadı.</li>';
                        return;
                    }

                    // kök tek node ise direkt onu çiz
                    const rootLi = buildOuNode(root);
                    treeEl.appendChild(rootLi);
                }

                async function loadOuTree() {
                    qs('#ouTree').innerHTML = '<li class="list-group-item small text-muted">Yükleniyor...</li>';
                    try {
                        const data = await fetchJson('/api/ad/ou-tree');
                        ouTreeData = data;
                        renderOuTree(data);
                    } catch (e) {
                        console.error(e);
                        qs('#ouTree').innerHTML = '<li class="list-group-item text-danger">OU listesi alınamadı.</li>';
                    }
                }

                // ========================
                // SONUÇ ÇİZİMİ (KULLANICI / BİLGİSAYAR)
                // ========================

                function renderUsers(users) {
                    const area = qs('#resultArea');
                    if (!users || !users.length) {
                        area.innerHTML = '<div class="alert alert-warning mt-2">Kullanıcı bulunamadı.</div>';
                        return;
                    }

                    let html = `
        <table class="table table-striped table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th>Kullanıcı Adı</th>
                    <th>İsim</th>
                    <th class="w-email">E-posta</th>
                    <th>Durum</th>
                    <th>OU</th>
                </tr>
            </thead>
            <tbody>
        `;
                    for (const u of users) {
                        const userName = u.userName || u.samAccountName || '';
                        const disp = u.displayName || '';
                        const mail = u.email || u.mail || '';
                        const dn = u.distinguishedName || '';
                        const enabled = (u.enabled ?? u.isEnabled ?? true);

                        html += `
        <tr>
            <td class="truncate" title="${userName}">${userName}</td>
            <td class="truncate" title="${disp}">${disp}</td>
            <td class="truncate w-email" title="${mail}">${mail}</td>
            <td>
                ${enabled
                    ? '<span class="badge bg-success">Aktif</span>'
                    : '<span class="badge bg-danger">Pasif</span>'}
            </td>
            <td class="text-muted small truncate" title="${dn}">
                ${formatOuPath(dn)}
            </td>
        </tr>`;
                    }

                    html += '</tbody></table>';
                    area.innerHTML = html;
                }

                function renderComputers(comps) {
                    const area = qs('#resultArea');
                    if (!comps || !comps.length) {
                        area.innerHTML = '<div class="alert alert-warning mt-2">Bilgisayar bulunamadı.</div>';
                        return;
                    }

                    let html = `
        <table class="table table-striped table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>İşletim Sistemi</th>
                    <th>Açıklama</th>
                    <th>OU</th>
                </tr>
            </thead>
            <tbody>
        `;
                    for (const c of comps) {
                        const name = c.name || '';
                        const os = c.operatingSystem || '';
                        const desc = c.description || '';
                        const dn = c.distinguishedName || '';

                        html += `
        <tr>
            <td class="truncate" title="${name}">${name}</td>
            <td class="truncate" title="${os}">${os}</td>
            <td class="truncate" title="${desc}">${desc}</td>
            <td class="text-muted small truncate" title="${dn}">
                ${formatOuPath(dn)}
            </td>
        </tr>`;
                    }

                    html += '</tbody></table>';
                    area.innerHTML = html;
                }

                function renderSearchSummary(html) {
                    qs('#resultArea').innerHTML = html;
                }

                // ========================
                // VERİ YÜKLEYİCİLER
                // ========================

                async function loadOuUsers() {
                    if (!currentOuDn) return;
                    const term = qs('#searchBox').value.trim();
                    qs('#resultArea').innerHTML = '<div class="text-muted">Kullanıcılar yükleniyor...</div>';
                    try {
                        const url = '/api/ad/users?term=' + encodeURIComponent(term) + '&ou=' + encodeURIComponent(currentOuDn);
                        const data = await fetchJson(url);
                        renderUsers(data);
                    } catch (e) {
                        console.error(e);
                        qs('#resultArea').innerHTML = '<div class="text-danger">Kullanıcılar alınırken hata oluştu.</div>';
                    }
                }

                async function loadOuComputers() {
                    if (!currentOuDn) return;
                    const term = qs('#searchBox').value.trim();
                    qs('#resultArea').innerHTML = '<div class="text-muted">Bilgisayarlar yükleniyor...</div>';
                    try {
                        const url = '/ad-computers/by-ou?ou=' + encodeURIComponent(currentOuDn) + '&term=' + encodeURIComponent(term);
                        const data = await fetchJson(url);
                        renderComputers(data);
                    } catch (e) {
                        console.error(e);
                        qs('#resultArea').innerHTML = '<div class="text-danger">Bilgisayarlar alınırken hata oluştu.</div>';
                    }
                }

                async function globalUserSearch() {
                    const term = qs('#searchBox').value.trim();
                    if (!term) {
                        qs('#resultArea').innerHTML = '<p class="text-muted">Soldan bir OU seçin ya da arama yapın.</p>';
                        return;
                    }

                    qs('#resultArea').innerHTML = '<div class="text-muted">Arama yapılıyor...</div>';
                    try {
                        const url = '/ad-users/search?term=' + encodeURIComponent(term);
                        const data = await fetchJson(url);
                        renderUsers(data);
                    } catch (e) {
                        console.error(e);
                        qs('#resultArea').innerHTML = '<div class="text-danger">Arama sırasında hata oluştu.</div>';
                    }
                }

                // ========================
                // EVENT BINDINGS
                // ========================

                document.addEventListener('DOMContentLoaded', () => {

                    // OU ağacı ilk yük
                    loadOuTree();

                    // Ağaç yenile
                    qs('#btnRefreshTree').addEventListener('click', () => {
                        currentOuDn = null;
                        qs('#selectedOuBadge').textContent = '';
                        qs('#ouActions').style.display = 'none';
                        loadOuTree();
                        qs('#resultArea').innerHTML = '<p class="text-muted">Soldan bir OU seçin ya da arama yapın.</p>';
                    });

                    // OU butonları
                    qs('#btnUsers').addEventListener('click', loadOuUsers);
                    qs('#btnComputers').addEventListener('click', loadOuComputers);

                    // Arama kutusu
                    let searchTimer = null;
                    qs('#searchBox').addEventListener('keyup', (ev) => {
                        clearTimeout(searchTimer);
                        if (ev.key === 'Enter') {
                            globalUserSearch();
                            return;
                        }
                        searchTimer = setTimeout(globalUserSearch, 400);
                    });

                    // Temizle
                    qs('#btnClearSearch').addEventListener('click', () => {
                        qs('#searchBox').value = '';
                        qs('#resultArea').innerHTML = '<p class="text-muted">Soldan bir OU seçin ya da arama yapın.</p>';
                    });
                });
    </script>
}
