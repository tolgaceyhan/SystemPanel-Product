@{
    ViewData["Title"] = "Active Directory | Kullanıcılar";
    var isLocalAdmin = User.IsInRole("LocalAdmin");
    var rootOu = User.FindFirst("ou:root")?.Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Kullanıcı Yönetimi</h4>
    @if (User.IsInRole("Admin"))
    {
        <button id="btnCreateUser" class="btn btn-success btn-sm">Yeni Kullanıcı</button>
    }
</div>

<div class="input-group mb-3">
    <input type="text" id="txtSearchUser" class="form-control" placeholder="Kullanıcı ara (ad, kullanıcı adı, mail)">
    <input type="text" id="txtOu" class="form-control" placeholder="OU" value="@rootOu" @(isLocalAdmin ? "readonly" : "")>
    <button id="btnSearchUser" class="btn btn-primary">Ara</button>
</div>

<div id="usersList" class="border rounded bg-white p-2" style="min-height:300px;">
    <div class="text-muted small">Kullanıcı listesi yüklenecek...</div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const list = document.getElementById("usersList");
            const btn = document.getElementById("btnSearchUser");
            const txt = document.getElementById("txtSearchUser");
            const ouInput = document.getElementById("txtOu");
            const rootOu = '@(rootOu ?? "")';
            const isLocalAdmin = '@User.IsInRole("LocalAdmin")'.toLowerCase() === 'true';

            async function loadUsers() {
                const term = encodeURIComponent(txt.value.trim());
                const ou = encodeURIComponent(isLocalAdmin ? rootOu : ouInput.value);
                const url = `/api/ad/users?term=${term}&provinceOrDn=${ou}`;
                const res = await fetch(url);
                const data = await res.json();

                list.innerHTML = "";
                if (!data || !data.length) {
                    list.innerHTML = '<div class="text-muted small">Kayıt bulunamadı.</div>';
                    return;
                }
                data.forEach(u => {
                    const div = document.createElement("div");
                    div.className = "d-flex justify-content-between border-bottom py-1 small";
                    div.innerHTML = `<span>${u.displayName || u.samAccountName}</span><span>${u.mail ?? ""}</span>`;
                    list.appendChild(div);
                });
            }

            btn.addEventListener("click", loadUsers);
            loadUsers();
        });
    </script>
}
