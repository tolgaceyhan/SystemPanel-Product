@{
    ViewData["Title"] = "Active Directory Bilgisayarları";
    Layout = "_Layout";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            <i class="bi bi-pc-display-horizontal"></i>
            AD Bilgisayarları
        </h4>

        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>
            <input type="text"
                   class="form-control"
                   id="computer-search"
                   placeholder="Bilgisayar, açıklama, OS ara..." />
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div id="table-loading" class="text-center my-4 d-none">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
                <div class="mt-2 small text-muted">
                    Bilgisayar listesi yükleniyor...
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover mb-0" id="computers-table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="sortable" data-sort="Name">
                                Ad
                                <span class="sort-indicator"></span>
                            </th>
                            <th scope="col" class="sortable d-none d-md-table-cell" data-sort="OperatingSystem">
                                İşletim Sistemi
                                <span class="sort-indicator"></span>
                            </th>
                            <th scope="col" class="d-none d-lg-table-cell">
                                Açıklama
                            </th>
                            <th scope="col" class="sortable d-none d-md-table-cell" data-sort="LastLogon">
                                Son Oturum
                                <span class="sort-indicator"></span>
                            </th>
                            <th scope="col" class="sortable" data-sort="Status">
                                Durum
                                <span class="sort-indicator"></span>
                            </th>
                            <th scope="col" class="text-end">
                                İşlemler
                            </th>
                        </tr>
                    </thead>
                    <tbody id="computers-body">
                        <tr class="table-active">
                            <td colspan="6" class="text-center text-muted py-4">
                                Liste yükleniyor...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center p-2 border-top bg-light">
                <div class="small text-muted" id="table-summary">
                    Toplam 0 kayıt
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="computers-pager">
                        <!-- JS ile doldurulacak -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Detay Modal -->
<div class="modal fade" id="computerDetailModal" tabindex="-1" aria-labelledby="computerDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="computerDetailModalLabel">Bilgisayar Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="computer-detail-loading" class="text-center my-4 d-none">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                </div>

                <div id="computer-detail-content" class="d-none">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Ad</dt>
                        <dd class="col-sm-9" id="detail-name"></dd>

                        <dt class="col-sm-3">DN</dt>
                        <dd class="col-sm-9"><code id="detail-dn"></code></dd>

                        <dt class="col-sm-3">İşletim Sistemi</dt>
                        <dd class="col-sm-9" id="detail-os"></dd>

                        <dt class="col-sm-3">Açıklama</dt>
                        <dd class="col-sm-9" id="detail-desc"></dd>

                        <dt class="col-sm-3">Son Oturum</dt>
                        <dd class="col-sm-9" id="detail-lastlogon"></dd>

                        <dt class="col-sm-3">Durum</dt>
                        <dd class="col-sm-9" id="detail-status"></dd>

                        <dt class="col-sm-3">LAPS Parolası</dt>
                        <dd class="col-sm-9">
                            <span id="detail-laps" class="font-monospace"></span>
                            <button type="button" class="btn btn-outline-primary btn-sm ms-2" id="btn-reveal-laps">
                                Göster
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm ms-1" id="btn-copy-laps">
                                Kopyala
                            </button>
                            <div id="detail-laps-info" class="small text-muted mt-1"></div>
                        </dd>
                    </dl>
                </div>

                <div id="computer-detail-error" class="alert alert-danger d-none mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/laps-reveal.js"></script>
    <script src="~/js/adcomputers.js"></script>
}
