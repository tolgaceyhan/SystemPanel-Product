@model IEnumerable<SystemPanel.Models.AdUser>

@inject SystemPanel.Security.IPermissionService PermissionService
@{
    ViewData["Title"] = "Active Directory - Kullanıcılar";

    // Yalnızca buton görünürlüğü; yetki ve kapsam kontrolü sunucuda yapılır.
    bool isAdmin = await PermissionService.HasAnyPermissionAsync(User, SystemPanel.Security.Permissions.AdUsersEdit, SystemPanel.Security.Permissions.AdUsersCreate);
    string rootOu = User.Claims.FirstOrDefault(c => c.Type == "ou:root")?.Value ?? "";
}

<div class="container-fluid mt-3">

    <h3><i class="fas fa-users me-2"></i> Active Directory Kullanıcıları</h3>

    <div class="card mt-3">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">

                <div class="col-md-4">
                    <input name="term"
                           placeholder="Kullanıcı adı, isim veya mail"
                           class="form-control" />
                </div>

                @if (isAdmin)
                {
                    <div class="col-md-5">
                        <input name="ou"
                               placeholder="OU gir (örn: OU=Birim,DC=example,DC=local)"
                               class="form-control" />
                    </div>
                }
                else
                {
                    <input type="hidden" name="ou" value="@rootOu" />
                }

                <div class="col-md-2">
                    <button class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i> Ara
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        @if (Model != null && Model.Any())
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Kullanıcı Adı</th>
                        <th>İsim</th>
                        <th>E-posta</th>
                        <th>Durum</th>

                        @if (isAdmin)
                        {
                            <th>OU</th>
                        }

                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.UserName</td>
                            <td>@u.DisplayName</td>
                            <td>@u.Email</td>
                            <td>
                                @if (u.Enabled)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pasif</span>
                                }
                            </td>

                            @if (isAdmin)
                            {
                                <td class="text-muted small">@u.DistinguishedName</td>
                            }

                            <td>
                                <a asp-action="Edit" asp-route-id="@u.DistinguishedName"
                                   class="btn btn-sm btn-secondary">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-warning mt-3">
                <i class="fas fa-info-circle me-1"></i> Kullanıcı bulunamadı.
            </div>
        }
    </div>

</div>
