@model (string UserDn, string DisplayName)
@{
    ViewData["Title"] = "Şifre Sıfırlama";
}
<h3 class="mb-3">🔐 Şifre Sıfırlama — <code>@Model.DisplayName</code></h3>

<form asp-action="ResetPassword" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userDn" value="@Model.UserDn" />
    <div class="mb-3">
        <label class="form-label">Yeni Şifre (boş bırakırsan otomatik üretilecek)</label>
        <input type="text" name="newPassword" class="form-control" />
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-warning">Şifreyi Sıfırla</button>
        <a class="btn btn-secondary" href="@Url.Action("Index","AdUser")">Geri</a>
    </div>
</form>

@if (TempData["NewPassword"] != null)
{
    <div class="alert alert-success mt-3">
        <strong>Yeni Şifre:</strong>
        <span id="generatedPassword">@TempData["NewPassword"]</span>
        <button class="btn btn-sm btn-outline-secondary ms-2" onclick="navigator.clipboard.writeText(document.getElementById('generatedPassword').textContent)">📋 Kopyala</button>
    </div>
}
