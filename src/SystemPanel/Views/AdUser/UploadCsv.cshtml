@{
    ViewData["Title"] = "Toplu Kullanıcı Yükleme";
}
<h3 class="mb-3">📥 Toplu Kullanıcı Oluştur</h3>

<form asp-action="UploadCsv" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="mb-2">
        <input type="file" name="csv" accept=".csv,text/csv" class="form-control" required />
        <div class="form-text">Sütunlar: UserName, DisplayName, Email, Password, OuPath</div>
    </div>
    <button class="btn btn-success" type="submit">Yükle</button>
    <a class="btn btn-secondary ms-2" href="@Url.Action("Index","AdUser")">Geri</a>
</form>

@if (TempData["BulkResult"] is string br && !string.IsNullOrWhiteSpace(br))
{
    <pre class="mt-3 p-3 bg-light border">@br</pre>
}
