@model SystemPanel.Services.Agents.AgentCredentials
@{
    ViewData["Title"] = "Agent Anahtarı";
    var rotated = ViewBag.Rotated as bool? ?? false;
    var serverUrl = ViewBag.ServerUrl as string;
}

<h2 class="fw-bold mt-2 mb-3">@(rotated ? "Yeni agent anahtarı" : "Agent kaydedildi")</h2>

<div class="alert alert-danger">
    <strong>Bu anahtar yalnızca şimdi gösteriliyor.</strong> @Branding.Value.ProductName anahtarın kendisini saklamaz; sayfayı kapattıktan sonra
    tekrar görüntülenemez. Kaybolursa "Anahtarı yenile" ile yenisini üretin.
    @if (rotated)
    {
        <div>Önceki anahtar geçersiz oldu; agent yeni anahtarla yapılandırılana kadar veri gönderemez.</div>
    }
</div>

<dl class="row">
    <dt class="col-sm-2">Sunucu</dt><dd class="col-sm-10">@Model.Hostname</dd>
    <dt class="col-sm-2">Agent ID</dt><dd class="col-sm-10"><code>@Model.AgentId</code></dd>
    <dt class="col-sm-2">Anahtar</dt><dd class="col-sm-10"><code class="user-select-all fs-6">@Model.Key</code></dd>
</dl>

<h5>Sunucuda kurulum (yönetici PowerShell)</h5>
<p class="small text-muted">Anahtar DPAPI (LocalMachine) ile şifrelenerek agent yapılandırmasına yazılır; ayrıntılar docs/AGENT.md.</p>
<pre class="bg-light border rounded p-2 text-wrap">.\Install-SystemPanelAgent.ps1 -ServerUrl "@serverUrl" -AgentId "@Model.AgentId"
# Betik anahtarı güvenli giriş olarak sorar; komut satırına yazmayın.</pre>

<a asp-action="Index" class="btn btn-secondary">Agent listesine dön</a>
