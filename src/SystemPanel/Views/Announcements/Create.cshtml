@model SystemPanel.ViewModels.Announcements.CreateAnnouncementViewModel

@{
    ViewBag.Title = "Yeni Duyuru Oluştur";
}

<h2 class="mt-3">Yeni Duyuru</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Turu" class="form-label"></label>
        <select asp-for="Turu" class="form-control" asp-items="new SelectList((IEnumerable<string>)ViewBag.Types)">
            <option value="">Seçiniz...</option>
        </select>
        <span asp-validation-for="Turu" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Birimi" class="form-label"></label>
        <input asp-for="Birimi" class="form-control" />
        <span asp-validation-for="Birimi" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Aciklama" class="form-label"></label>
        <input asp-for="Aciklama" class="form-control" />
        <span asp-validation-for="Aciklama" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Detay" class="form-label"></label>
        <textarea asp-for="Detay" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Detay" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="File" class="form-label"></label>
        <input asp-for="File" type="file" class="form-control" />
        <span asp-validation-for="File" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Oluştur</button>
    <a asp-action="List" class="btn btn-secondary">İptal</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
