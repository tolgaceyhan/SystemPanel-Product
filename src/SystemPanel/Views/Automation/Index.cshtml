@model IReadOnlyList<SystemPanel.Models.RunbookVersion>
@inject IPermissionService PermissionService
@{
    ViewData["Title"] = "Otomasyon";
    var canRun = await PermissionService.HasAnyPermissionAsync(User, Permissions.AutomationRun);
    var canManage = await PermissionService.HasAnyPermissionAsync(User, Permissions.AutomationManage);
    var awaiting = (int)(ViewBag.AwaitingDecision ?? 0);
}

<div class="d-flex justify-content-between align-items-center mt-2 mb-3">
    <h2 class="fw-bold mb-0">Otomasyon</h2>
    <div class="d-flex gap-2">
        @if (awaiting > 0)
        {
            <a asp-action="Approvals" class="btn btn-warning">Onayınızı bekleyen: @awaiting</a>
        }
        <a asp-action="Runs" class="btn btn-outline-secondary">Çalıştırmalar</a>
        @if (canManage)
        {
            <a asp-action="Manage" class="btn btn-outline-secondary">Katalog ve anahtarlar</a>
        }
    </div>
</div>
<partial name="_StatusMessages" />

<p class="text-muted">
    Yalnızca imzalı ve katalogdaki runbook'lar çalıştırılabilir. Orta ve yüksek riskli işlemler ikinci bir yetkilinin
    onayını gerektirir; yüksek riskli işlemlerde önce değişiklik yapılmadan önizleme alınır. Tüm adımlar denetim kaydına yazılır.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Katalogda runbook yok. @(canManage ? "Katalog ve anahtarlar ekranından imzalı paket içe aktarın." : "Otomasyon yöneticinizle görüşün.")</div>
}
else
{
    <div class="row g-3">
        @foreach (var rb in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@rb.Title</h5>
                            <partial name="_Badges" model='("risk", rb.Risk)' />
                        </div>
                        <div class="small text-muted mb-2"><code>@rb.RunbookId</code> · v@(rb.Version)</div>
                        <p class="card-text flex-grow-1">@rb.Description</p>
                        @if (canRun)
                        {
                            <a asp-action="NewRun" asp-route-versionId="@rb.Id" class="btn btn-primary btn-sm align-self-start">Çalıştırma talebi</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
