@model SystemPanel.Models.RunbookRun
@{
    ViewData["Title"] = "Çalıştırma";
    var parameters = ViewBag.Parameters as IReadOnlyDictionary<string, string?> ?? new Dictionary<string, string?>();
    var canDecide = (bool)(ViewBag.CanDecide ?? false);
    var canCancel = (bool)(ViewBag.CanCancel ?? false);
}

<div class="d-flex justify-content-between align-items-center mt-2 mb-3">
    <h2 class="fw-bold mb-0">@Model.RunbookVersion?.Title</h2>
    <a asp-action="Runs" class="btn btn-outline-secondary">Çalıştırmalar</a>
</div>
<partial name="_StatusMessages" />

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Durum</dt><dd class="col-sm-9"><partial name="_Badges" model='("status", Model.Status)' /></dd>
            <dt class="col-sm-3">Runbook</dt><dd class="col-sm-9"><code>@Model.RunbookVersion?.RunbookId</code> v@(Model.RunbookVersion?.Version) <partial name="_Badges" model='("risk", Model.RunbookVersion?.Risk ?? "high")' /></dd>
            <dt class="col-sm-3">Talep eden</dt><dd class="col-sm-9">@Model.RequestedBy · @Model.RequestedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
            @if (!string.IsNullOrWhiteSpace(Model.Justification))
            {
                <dt class="col-sm-3">Gerekçe</dt><dd class="col-sm-9">@Model.Justification</dd>
            }
            <dt class="col-sm-3">Onay</dt>
            <dd class="col-sm-9">
                @(Model.RequiredApprovals == 0 ? "Gerekmiyor" : $"{Model.Approvals.Count(a => a.Decision == "approved")}/{Model.RequiredApprovals}")
                @if (Model.ApprovalExpiresAtUtc != null && Model.Status == "PendingApproval")
                {
                    <span class="text-muted small">· son tarih @Model.ApprovalExpiresAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC</span>
                }
            </dd>
            @if (Model.StartedAtUtc != null)
            {
                <dt class="col-sm-3">Çalışma</dt><dd class="col-sm-9">@Model.StartedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") → @(Model.FinishedAtUtc?.ToString("HH:mm:ss") ?? "…") UTC @(Model.ExitCode != null ? $"(çıkış kodu {Model.ExitCode})" : "")</dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <dt class="col-sm-3">Hata</dt><dd class="col-sm-9 text-danger">@Model.Error</dd>
            }
        </dl>
    </div>
</div>

<h5>Parametreler</h5>
<table class="table table-sm w-auto">
    @foreach (var (k, v) in parameters)
    {
        <tr><th class="pe-4">@k</th><td class="text-break">@v</td></tr>
    }
</table>

@if (Model.PreviewOutput != null)
{
    <h5>Önizleme (değişiklik yapılmadı)</h5>
    <pre class="bg-light border rounded p-2 small" style="max-height: 400px; overflow: auto">@Model.PreviewOutput</pre>
}

@if (Model.Approvals.Count > 0)
{
    <h5>Kararlar</h5>
    <ul>
        @foreach (var a in Model.Approvals.OrderBy(a => a.DecidedAtUtc))
        {
            <li>@a.Approver — <strong>@(a.Decision == "approved" ? "onayladı" : "reddetti")</strong> · @a.DecidedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC @(string.IsNullOrWhiteSpace(a.Comment) ? "" : "· " + a.Comment)</li>
        }
    </ul>
}

@if (Model.Output != null)
{
    <h5>Çıktı</h5>
    <pre class="bg-light border rounded p-2 small" style="max-height: 500px; overflow: auto">@Model.Output</pre>
}

@if (canDecide)
{
    <div class="card border-warning mt-3" style="max-width: 640px">
        <div class="card-body">
            <h5 class="card-title">Karar</h5>
            <p class="small text-muted">Önizlemeyi ve parametreleri kontrol edin. Onayınız denetim kaydına adınızla yazılır.</p>
            <form method="post" class="d-flex flex-column gap-2">
                @Html.AntiForgeryToken()
                <input name="comment" class="form-control" maxlength="500" placeholder="Açıklama (opsiyonel)" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success" asp-action="Approve" asp-route-id="@Model.Id">Onayla</button>
                    <button type="submit" class="btn btn-outline-danger" asp-action="Reject" asp-route-id="@Model.Id">Reddet</button>
                </div>
            </form>
        </div>
    </div>
}

@if (canCancel)
{
    <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="mt-3" onsubmit="return confirm('Talep iptal edilsin mi?');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary">Talebi iptal et</button>
    </form>
}
