@model List<SystemPanel.ViewModels.Files.FileItemViewModel>

@{
    ViewData["Title"] = "Dosya Yönetimi";
}

<h2>Dosya Yönetimi</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Dosya Adı</th>
            <th>Boyut</th>
            <th class="text-end">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="3" class="text-muted">Klasörde dosya bulunamadı.</td></tr>
        }
        else
        {
            foreach (var file in Model)
            {
                <tr>
                    <td>@file.Name</td>
                    <td>@file.SizeDisplay</td>
                    <td class="text-end">
                        <a asp-action="Download" asp-route-fileName="@file.Name" class="btn btn-sm btn-outline-secondary me-2">İndir</a>
                        <form asp-action="DeleteFile" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="fileName" value="@file.Name" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                Sil
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<h5>Yeni Dosya Yükle</h5>
<form asp-action="UploadFile" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="mb-2">
        <input type="file" name="file" class="form-control" />
    </div>
    <button class="btn btn-primary" type="submit">Yükle</button>
</form>
