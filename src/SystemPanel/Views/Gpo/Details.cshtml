@model SystemPanel.ViewModels.Gpo.GpoViewModel
@using SystemPanel.Security
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = $"{Model?.DisplayName} - GPO Detayları";
    var perms = await PermissionService.GetPermissionsAsync(User);
    bool canLink = perms.Contains(Permissions.GpoLink);
    bool canEdit = perms.Contains(Permissions.GpoEdit);
    bool canBackup = perms.Contains(Permissions.GpoBackup);
    bool canDelete = perms.Contains(Permissions.GpoDelete) && (ViewBag.AllowDelete as bool? ?? false);
}

<h2 class="mb-4">📝 GPO Detayları</h2>
<partial name="_StatusMessages" />

@if (Model == null)
{
    <div class="alert alert-danger">GPO bulunamadı.</div>
    return;
}

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white fw-bold">
        <i class="fa-solid fa-shield-halved me-1"></i>
        @Model.DisplayName
    </div>

    <div class="card-body">

        <div class="row mb-4">

            <div class="col-md-6">
                <h5 class="fw-bold mb-3">📌 Temel Bilgiler</h5>

                <p><strong>ID:</strong> @Model.Id</p>
                <p><strong>Açıklama:</strong> @(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</p>

                <p>
                    <strong>Durum:</strong>
                    @if (Model.IsEnabled)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Devre Dışı</span>
                    }
                </p>

                <p><strong>Oluşturma Tarihi:</strong> @Model.CreatedTime</p>
                <p><strong>Değişiklik Tarihi:</strong> @Model.ModifiedTime</p>
                <p><strong>Sahibi:</strong> @(Model.Owner ?? "-") </p>
                <p><strong>Domain:</strong> @(Model.DomainName ?? "-") </p>
            </div>

            <div class="col-md-6">
                <h5 class="fw-bold mb-3">⚙️ Teknik Bilgiler</h5>

                <p><strong>GPO Versiyon:</strong> @(Model.GpoVersion ?? "-")</p>
                <p><strong>GPO Tipi:</strong> @(Model.GpoType ?? "-")</p>

                <p>
                    <strong>GPO Path:</strong><br />
                    <code>@(Model.GpoPath ?? "-")</code>
                </p>
            </div>

        </div>

        <hr />

        <!-- OU Links -->
        <h5 class="fw-bold mt-4">📂 Bağlı OU'lar</h5>

        @if (Model.LinkedOus != null && Model.LinkedOus.Any())
        {
            <ul class="list-group mb-4">
                @foreach (var ou in Model.LinkedOus)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-sitemap me-2"></i> @ou</span>
                        @if (canLink)
                        {
                            <form asp-action="Unlink" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu OU bağlantısı kaldırılsın mı? GPO artık bu OU\'ya uygulanmayacak.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="ouDn" value="@ou" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Bağlantıyı kaldır</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Bağlı OU yok.</p>
        }

        <!-- Site Links -->
        <h5 class="fw-bold mt-4">🌐 Bağlı Siteler</h5>

        @if (Model.LinkedSites != null && Model.LinkedSites.Any())
        {
            <ul class="list-group mb-4">
                @foreach (var site in Model.LinkedSites)
                {
                    <li class="list-group-item">
                        <i class="fa-solid fa-network-wired me-2"></i> @site
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Bağlı site yok.</p>
        }

        <hr />

        <div class="d-flex flex-wrap gap-2 justify-content-end">
            @if (canLink)
            {
                <a asp-action="LinkToOu" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="fa-solid fa-link me-1"></i> OU'ya Bağla
                </a>
            }
            @if (canEdit)
            {
                <form asp-action="Toggle" method="post" class="d-inline"
                      onsubmit="return confirm('@(Model.IsEnabled ? "GPO devre dışı bırakılsın mı?" : "GPO etkinleştirilsin mi?")');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="enable" value="@(Model.IsEnabled ? "false" : "true")" />
                    <button type="submit" class="btn @(Model.IsEnabled ? "btn-warning" : "btn-success")">
                        @(Model.IsEnabled ? "Devre Dışı Bırak" : "Etkinleştir")
                    </button>
                </form>
            }
            @if (canBackup)
            {
                <form asp-action="Backup" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-box-archive me-1"></i> Yedekle
                    </button>
                </form>
            }
            <a href="@Url.Action("Index", "Gpo")" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> Geri Dön
            </a>
        </div>

    </div>
</div>

@section Scripts {
}

@if (canDelete)
{
    <div class="card border-danger mt-4">
        <div class="card-header bg-danger text-white fw-bold">Tehlikeli işlem: GPO'yu sil</div>
        <div class="card-body">
            <p class="mb-2">Bu işlem geri alınamaz. Silmeden önce yedek almanız önerilir. Onaylamak için GPO adını birebir yazın:</p>
            <form asp-action="Delete" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="col-md-8">
                    <input type="text" name="confirmName" class="form-control" placeholder="@Model.DisplayName" autocomplete="off" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-danger w-100">GPO'yu kalıcı olarak sil</button>
                </div>
            </form>
        </div>
    </div>
}
