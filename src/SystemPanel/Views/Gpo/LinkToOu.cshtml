@model SystemPanel.ViewModels.Gpo.LinkToOuViewModel

@{
    ViewData["Title"] = "GPO → OU Atama";
}

<h2 class="mb-4">📌 GPO → OU Ata</h2>
<p class="text-muted">GPO: <strong>@Model.GpoName</strong></p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation me-1"></i> @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-check-circle me-1"></i> @TempData["Success"]
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="LinkToOu" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="GpoId" />
            <input type="hidden" asp-for="GpoName" />

            <div class="mb-3">
                <label class="form-label fw-bold">
                    🎯 Hedef OU Seç
                </label>

                <select asp-for="OrganizationalUnit" class="form-select">
                    <option value="">-- OU seçin --</option>

                    @foreach (var item in (ViewBag.OuList as List<string>) ?? new List<string>())
                    {
                        <option value="@item">@item</option>
                    }
                </select>

                <span asp-validation-for="OrganizationalUnit" class="text-danger small"></span>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <a href="@Url.Action("Index","Gpo")" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Geri Dön
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-link me-1"></i> OU'ya Bağla
                </button>
            </div>

        </form>

    </div>
</div>


