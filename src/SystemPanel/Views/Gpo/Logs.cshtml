@model IEnumerable<SystemPanel.ViewModels.Gpo.GpoLogViewModel>

@{
    ViewData["Title"] = "📜 GPO Log Kayıtları";
}

<h2 class="mb-4"><i class="fas fa-clipboard-list me-2"></i>GPO Log Kayıtları</h2>

@if (Model != null && Model.Any())
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>📅 Tarih</th>
                    <th>👤 Kullanıcı</th>
                    <th>⚙️ İşlem</th>
                    <th>📝 Açıklama</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@log.Username</td>
                        <td>@log.Action</td>
                        <td>@log.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">
        <i class="fas fa-info-circle me-2"></i> Bu GPO için henüz log kaydı bulunmamaktadır.
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Geri Dön
    </a>
</div>

@section Scripts {
}
