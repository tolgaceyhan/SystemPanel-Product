
@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Kullanıcı Detayları";
}

<h2>Kullanıcı Detayları</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Kullanıcı Adı:</strong> @Model.UserName</p>
        <p><strong>E-posta:</strong> @Model.Email</p>
        <p><strong>ID:</strong> @Model.Id</p>
    </div>
</div>

<a href="@Url.Action("Index", "UserManagement")" class="btn btn-secondary mt-3">Geri Dön</a>
