
@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Parola Sıfırlama";
}

<h2>Parola Sıfırla</h2>

<form method="post" asp-action="ResetPassword">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Kullanıcı Adı</label>
        <input type="text" class="form-control" value="@Model.UserName" disabled />
    </div>

    <div class="mb-3">
        <label for="newPassword" class="form-label">Yeni Parola</label>
        <input type="password" class="form-control" name="newPassword" required />
    </div>

    <button type="submit" class="btn btn-primary">Parolayı Güncelle</button>
    <a href="@Url.Action("Index", "UserManagement")" class="btn btn-secondary">İptal</a>
</form>
