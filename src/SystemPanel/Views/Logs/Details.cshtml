@model SystemPanel.ViewModels.Logs.LogDetailViewModel

@{
    ViewData["Title"] = "Log Detayı";
}

<h2 class="fw-bold mt-2 mb-4">Log Detayı #@Model.Id</h2>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Zaman</dt>
            <dd class="col-sm-10">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            <dt class="col-sm-2">Seviye</dt>
            <dd class="col-sm-10">@Model.Level</dd>
            <dt class="col-sm-2">Mesaj</dt>
            <dd class="col-sm-10">@Model.Message</dd>
            <dt class="col-sm-2">Detay</dt>
            <dd class="col-sm-10"><pre class="mb-0 text-wrap">@Model.Details</pre></dd>
            <dt class="col-sm-2">Kullanıcı</dt>
            <dd class="col-sm-10">@Model.User</dd>
            <dt class="col-sm-2">IP</dt>
            <dd class="col-sm-10">@Model.IP</dd>
        </dl>
    </div>
</div>

<a asp-action="RelatedLogs" asp-route-id="@Model.Id" class="btn btn-outline-primary">İlgili Loglar</a>
<a asp-action="Index" class="btn btn-secondary">Geri</a>
