@model IEnumerable<SystemPanel.Models.SccmLog>

<h2 class="mb-4">SCCM Log Kayıtları</h2>

<a class="btn btn-primary mb-3" href="@Url.Action("Create")">Yeni Log Ekle</a>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>IP Adresi</th>
            <th>Tarih</th>
            <th>Log Mesajı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Ip</td>
                <td>@log.Tarih?.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@log.ScLog</td>
                <td>
                    <a href="@Url.Action("Details", new { id = log.Id })" class="btn btn-info btn-sm me-1">Detay</a>
                    <a href="@Url.Action("Edit", new { id = log.Id })" class="btn btn-warning btn-sm me-1">Düzenle</a>
                    <form method="post" action="@Url.Action("Delete", new { id = log.Id })" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>