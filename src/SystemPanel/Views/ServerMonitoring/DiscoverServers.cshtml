@model List<SystemPanel.Models.AdServer>

@{
    ViewData["Title"] = "Sunucu Keşfi";
}




<h2 class="mb-4">🧭 Domain Üzerindeki Sunucuları Keşfet</h2>


<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="DiscoverServers" method="get" class="row g-3">
            <div class="col-md-5">
                <label class="form-label">OU (Organizational Unit)</label>
                <input type="text" name="ou" class="form-control" placeholder="OU girin..." />
            </div>
            <div class="col-md-5">
                <label class="form-label">IP Aralığı (örn: 192.168.1)</label>
                <input type="text" name="ipPrefix" class="form-control" placeholder="IP prefix girin..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    🔍 Filtrele
                </button>
            </div>
        </form>
    </div>
</div>

<div class="alert alert-info">
    Agent kurulumu GPO / SCCM üzerinden yapılmaktadır.
    Agent yüklü olmayan sunucular izlenmez.
</div>


@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>🖥️ Sunucu</th>
                    <th>🌐 IP</th>
                    <th>💻 OS</th>
                    <th>📍 OU</th>
                    <th>🧩 Agent</th>
                    <th>🧪 İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var server in Model)
                {
                    <tr>
                        <td>@server.Name</td>
                        <td>@server.IpAddress</td>
                        <td>@server.OperatingSystem</td>
                        <td>@server.OrganizationalUnit</td>

                        <td>
                            @if (!server.AgentInstalled)
                            {
                                <span class="badge bg-secondary">Yüklü Değil</span>
                            }
                            else if (server.AgentOnline)
                            {
                                <span class="badge bg-success">Online</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Offline</span>
                            }
                        </td>

                        <td class="text-nowrap">
                   
                            <!-- İzlemeye Al -->
                            <form asp-controller="ServerMonitoring"
                                  asp-action="AddServer"
                                  method="post"
                                  class="d-inline ms-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="serverName" value="@server.Name" />
                                <button class="btn btn-primary btn-sm">➕ İzlemeye Al</button>
                            </form>

                            <a asp-controller="ServerMonitoring"
                               asp-action="Details"
                               asp-route-id="@server.Name"
                               class="btn btn-info btn-sm ms-1">📊 Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning mt-4">
        Gösterilecek sunucu bulunamadı. Lütfen OU veya IP filtresi kullanın.
    </div>
}
