@model List<SystemPanel.ViewModels.Server.ServerSummaryViewModel>

@{
    ViewData["Title"] = "Sunucu İzleme Paneli";

    Func<string, string> SafeId = name => name?.ToLowerInvariant()
        .Replace(" ", "")
        .Replace("-", "")
        .Replace(".", "")
        .Replace("\\", "")
        .Replace("/", "") ?? "unknown";
}

<h2 class="mb-4">🖥️ Sunucu İzleme Paneli</h2>

<div class="mb-3">
    <a class="btn btn-outline-primary me-2"
       asp-controller="ServerMonitoring"
       asp-action="Manage">🛠️ Yönet</a>
</div>

<!-- Özet Kartlar -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-bg-primary shadow-sm">
            <div class="card-body">
                <h6 class="card-title">Toplam Sunucu</h6>
                <p class="display-6">@ViewBag.TotalServers</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-bg-success shadow-sm">
            <div class="card-body">
                <h6 class="card-title">Online</h6>
                <p class="display-6">@ViewBag.OnlineServerCount</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-bg-secondary shadow-sm">
            <div class="card-body">
                <h6 class="card-title">Offline</h6>
                <p class="display-6">@ViewBag.OfflineServerCount</p>
            </div>
        </div>
    </div>
</div>

<!-- Sunucu Kartları -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var server in Model)
    {
        var safeId = SafeId(server.ServerName);
        var maxDisk = server.DiskUsages.Any()
        ? server.DiskUsages.Values.Max()
        : 0;

        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">@server.ServerName</h5>
                    <small class="text-muted">@server.Description</small>

                    <!-- CPU -->
                    <div class="mt-3">
                        <small>CPU</small>
                        <div class="progress">
                            <div class="progress-bar bg-success"
                                 id="cpu-bar-@safeId"
                                 style="width:@server.CpuUsage%">
                                <span id="cpu-@safeId">@server.CpuUsage%</span>
                            </div>
                        </div>
                    </div>

                    <!-- RAM -->
                    <div class="mt-2">
                        <small>RAM</small>
                        <div class="progress">
                            <div class="progress-bar bg-info"
                                 id="ram-bar-@safeId"
                                 style="width:@server.RamUsage%">
                                <span id="ram-@safeId">@server.RamUsage%</span>
                            </div>
                        </div>
                    </div>

                    <!-- DISK -->
                    <div class="mt-2">
                        <small>Disk</small>
                        <div class="progress">
                            <div class="progress-bar bg-warning"
                                 id="disk-bar-@safeId"
                                 style="width:@maxDisk%">
                                <span id="disk-@safeId">@maxDisk%</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 text-end">
                        <a class="btn btn-outline-secondary btn-sm"
                           asp-action="Details"
                           asp-route-id="@server.ServerName">
                            Detay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
