@model SystemPanel.ViewModels.Server.ServerFilterViewModel
@{
    ViewData["Title"] = "Sunucu Yönetimi";
}

<h2 class="mb-4">🛠️ Kayıtlı Sunucular</h2>

<a asp-action="CreateServer" class="btn btn-outline-primary mb-3">➕ Yeni Sunucu Ekle</a>

<!-- 🔍 Filtre Formu -->
<form method="get" class="row mb-4">
    <div class="col-md-3">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Sunucu adı / IP ara..." />
    </div>
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="">Tüm Türler</option>
            <option value="Physical" selected="@(Model.Type == "Physical")">Physical</option>
            <option value="Virtual" selected="@(Model.Type == "Virtual")">Virtual</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="isActive" class="form-select">
            <option value="">Tümü</option>
            <option value="true" selected="@(Model.IsActive == true)">Aktif</option>
            <option value="false" selected="@(Model.IsActive == false)">Pasif</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Filtrele</button>
    </div>
</form>

<!-- 📋 Tablo -->
<table class="table table-bordered table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Adı</th>
            <th>Açıklama</th>
            <th>IP</th>
            <th>Tür</th>
            <th>Lokasyon</th>
            <th>Durum</th>
            <th class="text-center">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var server in Model.Servers)
        {
            <tr>
                <td>@server.Name</td>
                <td>@server.Description</td>
                <td>@server.IpAddress</td>
                <td>@server.Type</td>
                <td>@server.Location</td>
                <td>
                    <span class="badge @(server.IsActive ? "bg-success" : "bg-secondary")">
                        @(server.IsActive ? "Aktif" : "Pasif")
                    </span>
                </td>
                <td class="text-center">
                    <a asp-action="Details" asp-route-serverName="@server.Name" class="btn btn-sm btn-outline-info me-1">Detay</a>
                    <a asp-action="EditServer" asp-route-id="@server.Id" class="btn btn-sm btn-outline-warning me-1">Düzenle</a>
                    <form asp-action="RemoveServer" method="post" class="d-inline">
                        <input type="hidden" name="serverName" value="@server.Name" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
