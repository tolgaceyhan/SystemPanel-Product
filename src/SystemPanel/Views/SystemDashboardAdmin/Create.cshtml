@model SystemPanel.Models.SystemDashboardLink

@{
    ViewData["Title"] = "Yeni Dashboard Paneli";
}

<h3>Yeni Dashboard Paneli</h3>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6 mb-2">
            <label>Başlık</label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="col-md-6 mb-2">
            <label>Screen</label>
            <select asp-for="Screen" class="form-control">
                <option value="A">Screen A</option>
                <option value="B">Screen B</option>
                <option value="C">Screen C</option>
            </select>
        </div>
    </div>

    <div class="mb-2">
        <label>URL</label>
        <input asp-for="Url" class="form-control" required />
    </div>

    <div class="row">
        <div class="col-md-3 mb-2">
            <label>Pozisyon</label>
            <select asp-for="Position" class="form-control">
                <option value="1">1 – Sol Üst</option>
                <option value="2">2 – Sağ Üst</option>
                <option value="3">3 – Sol Alt</option>
                <option value="4">4 – Sağ Alt</option>
            </select>
        </div>

        <div class="col-md-3 mb-2">
            <label>Refresh (sn)</label>
            <input asp-for="RefreshIntervalSec"
                   type="number"
                   class="form-control"
                   placeholder="Boş = kapalı" />
        </div>

        <div class="col-md-3 mb-2">
            <label>Zoom</label>
            <input asp-for="ZoomFactor"
                   type="number"
                   step="0.1"
                   min="0.1"
                   max="2.0"
                   class="form-control"
                   placeholder="1 = %100, 0.4 = %40" />
        </div>

        <div class="col-md-3 mb-2 d-flex align-items-end">
            <label class="form-check-label">
                <input asp-for="IsActive" class="form-check-input" checked />
                Aktif
            </label>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </div>
</form>
