@model SystemPanel.Models.SystemDashboardLink

<h3>Dashboard Panel Düzenle</h3>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-6 mb-2">
            <label>Başlık</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="col-md-6 mb-2">
            <label>Screen</label>
            <select asp-for="Screen" class="form-control">
                <option value="A">Screen A</option>
                <option value="B">Screen B</option>
                <option value="C">Screen C</option>
            </select>
        </div>
    </div>

    <div class="mb-2">
        <label>URL</label>
        <input asp-for="Url" class="form-control" />
    </div>

    <div class="row">
        <div class="col-md-3 mb-2">
            <label>Pozisyon</label>
            <select asp-for="Position" class="form-control">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
            </select>
        </div>

        <div class="col-md-3 mb-2">
            <label>Refresh (sn)</label>
            <input asp-for="RefreshIntervalSec" class="form-control" />
        </div>

        <div class="col-md-3 mb-2">
            <label>Zoom</label>
            <input asp-for="ZoomFactor"
                   type="number"
                   step="0.1"
                   class="form-control" />
        </div>

        <div class="col-md-3 mb-2 d-flex align-items-end">
            <label>
                <input asp-for="IsActive" /> Aktif
            </label>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </div>
</form>
