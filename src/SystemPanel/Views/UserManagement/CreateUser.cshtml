@using SystemPanel.ViewModels.UserManagement
@model CreateUserViewModel

@{
    ViewData["Title"] = "Kullanıcı Oluştur";
}

<h3 class="mb-4">Yeni Kullanıcı Oluştur</h3>

<form method="post">
    <div class="row">

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Kullanıcı Adı</label>
            <input class="form-control" asp-for="UserName" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">E-posta</label>
            <input class="form-control" asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Telefon</label>
            <input class="form-control" asp-for="PhoneNumber" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Rol</label>
            <select class="form-select" asp-for="Role">
                <option value="">Rol Seçin</option>
                <option value="Admin">Admin</option>
                <option value="Operator">Operator</option>
                <option value="LocalAdmin">LocalAdmin</option>
                <option value="Monitoring">Monitoring</option>
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Parola</label>
            <input class="form-control" asp-for="Password" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Parola (Tekrar)</label>
            <input class="form-control" asp-for="ConfirmPassword" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="col-md-12">
            <button class="btn btn-success">
                <i class="fas fa-user-plus me-1"></i> Oluştur
            </button>
            <a href="@Url.Action("Index","UserManagement")" class="btn btn-secondary ms-2">Geri</a>
        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
