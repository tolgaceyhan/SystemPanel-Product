{
    "_comment": "ÖRNEK DOSYA. Kopyalayıp sunucuda appsettings.Production.json olarak kaydedin (git'e EKLEMEYİN). Parola/anahtar alanlarını boş bırakıp ortam değişkeni ile verin (ör. Ldap__BindPassword) veya 'dpapi:' önekli korumalı değer kullanın. Bkz. docs/SECURITY.md ve docs/DEPLOYMENT.md. <...> ile işaretli değerler ortamınıza göre doldurulmalıdır.",

    "ConnectionStrings": {
        "DefaultConnection": "Server=<sql-sunucu>,1433;Database=SystemPanelData;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;"
    },

    "SCCM": {
        "SqlServer": "<sccm-sql-sunucu>",
        "Database": "<CM_SITE>",
        "SqlUser": "",
        "SqlPassword": "",
        "WmiUsername": "",
        "WmiPassword": ""
    },

    "Alerting": {
        "Smtp": {
            "Host": "<smtp-sunucu>",
            "Port": 25,
            "User": "",
            "Password": "",
            "From": "<gonderen@domain>",
            "To": [ "<noc@domain>" ]
        }
    },

    "ActiveDirectory": {
        "Domain": "<ad-domain-fqdn>",
        "Scope": {
            "_comment": "LocalAdmin/Operator kapsamı kullanıcının kendi DN'inden türetilir. Bkz. docs/AUTHORIZATION.md",
            "AnchorOu": "<il OU'larının bağlı olduğu OU adı>",
            "BranchOus": [ "<kullanıcı dalı OU adı>", "<bilgisayar dalı OU adı>" ],
            "LocalAdminGroupSuffix": "<il yönetici grubu soneki>",
            "ExcludedLocalAdminGroups": [ "<tüm iller için olan grup>" ]
        },
        "Directory": {
            "LocalAdminGroupsOu": "OU=<...>,DC=<...>",
            "UsersBaseOu": "OU=<...>,DC=<...>",
            "ExcludedUserOus": [ "<toplu SMS dışı OU>" ],
            "BranchManagerTitle": "<AD title değeri>"
        },
        "ProtectedGroups": [ "<üyeliği panelden değiştirilemeyecek ek gruplar>" ]
    },

    "Ldap": {
        "Host": "<ad-domain-fqdn veya DC>",
        "Port": 636,
        "UseSsl": true,
        "BaseDn": "DC=<...>,DC=<...>",
        "BindUser": "",
        "BindPassword": ""
    },

    "SMS": {
        "ApiUrl": "<sms-ağ-geçidi-url>",
        "ApiKeySecretName": "SMS_API_KEY"
    },

    "RoleMapping": {
        "Admin": [ "<AD grup adı>" ],
        "LocalAdmin": [ "<AD grup adı>" ],
        "Operator": [ "<AD grup adı>" ],
        "Helpdesk": [ "<AD grup adı>" ],
        "Monitoring": [ "<AD grup adı>" ]
    },

    "FileStorage": {
        "Root": "<D:\\SystemPanel\\Files>"
    }
}
